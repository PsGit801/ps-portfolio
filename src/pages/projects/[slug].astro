---
import Base from '../../layouts/Base.astro';
import { projects, profile } from '../../data/resume';

export function getStaticPaths() {
  return projects
    .filter((p) => p.slug && p.detail)
    .map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props;
const d = project.detail!;
---

<Base title={`${project.name} — ${profile.name}`} description={d.tagline}>
  <header class="topbar">
    <div class="container topbar__inner">
      <a class="back" href="/projects">
        <span aria-hidden="true">←</span> All projects
      </a>
      <button class="theme-toggle" data-theme-toggle aria-label="Toggle theme" type="button">☾</button>
    </div>
  </header>

  <main class="case bg-grid">
    <div class="container">
      <section class="case__head reveal">
        <p class="eyebrow">Case study</p>
        <h1 class="case__title">{project.name}</h1>
        <p class="case__tagline">{d.tagline}</p>
        <ul class="case__stack">
          {d.stack.map((s) => <li class="chip">{s}</li>)}
        </ul>
        {
          project.links && project.links.length > 0 && (
            <div class="case__links">
              {project.links.map((l) => (
                <a class="case__link" href={l.href} target="_blank" rel="noopener">
                  {l.label} <span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          )
        }
      </section>

      <section class="case__overview reveal">
        {d.overview.map((p) => <p>{p}</p>)}
      </section>

      {
        d.gallery.length > 0 && (
          <section class="gallery reveal" aria-label="Screenshots">
            {d.gallery.map((g) => (
              <figure class="shot">
                <img src={g.src} alt={g.alt} loading="lazy" decoding="async" />
                {g.caption && <figcaption>{g.caption}</figcaption>}
              </figure>
            ))}
          </section>
        )
      }

      <section class="build reveal" aria-label="What I built">
        <h2 class="build__heading">What I built</h2>
        <ol class="build__list">
          {
            d.build.map((b, i) => (
              <li class="build__item">
                <span class="build__num">{String(i + 1).padStart(2, '0')}</span>
                <div>
                  <h3 class="build__title">{b.title}</h3>
                  <p class="build__body">{b.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="case__foot reveal">
        <a class="back back--foot" href="/projects">
          <span aria-hidden="true">←</span> All projects
        </a>
      </div>
    </div>
  </main>
</Base>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(10px);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .topbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono, monospace);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  .back:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    font-size: 1rem;
  }

  .case {
    padding: 3rem 0 4.5rem;
  }

  .case__head {
    max-width: 760px;
    margin-bottom: 2.75rem;
  }
  .case__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.25rem;
  }
  .case__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .case__link:hover {
    background: var(--accent);
    color: #fff;
    text-decoration: none;
  }

  .case__title {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    line-height: 1.1;
    margin: 0.6rem 0 0.9rem;
    letter-spacing: -0.02em;
  }
  .case__tagline {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .case__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 1.4rem;
  }

  .case__overview {
    max-width: 720px;
    display: grid;
    gap: 1rem;
    margin-bottom: 3rem;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text);
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.1rem;
    margin-bottom: 3.5rem;
  }
  .shot {
    margin: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot figcaption {
    padding: 0.7rem 0.9rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
  }

  .build {
    max-width: 820px;
  }
  .build__heading {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }
  .build__list {
    display: grid;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .build__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
  }
  .build__num {
    font-family: var(--font-mono, monospace);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
    padding-top: 0.15rem;
  }
  .build__title {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }
  .build__body {
    color: var(--text-muted);
    line-height: 1.65;
  }

  .case__foot {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .back--foot {
    font-size: 0.85rem;
  }
</style>
