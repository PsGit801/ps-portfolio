---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, projectCategories, profile } from '../../data/resume';

// Only categories that have projects, in their configured order.
const groups = projectCategories
  .map((c) => ({ ...c, items: projects.filter((p) => p.category === c.id) }))
  .filter((g) => g.items.length > 0);
---

<Base
  title={`Projects — ${profile.name}`}
  description="AI systems, production websites, and research by Liew Phing Shuin."
>
  <Nav active="/projects" />
  <main>
    <section class="head bg-grid">
      <div class="container">
        <p class="eyebrow reveal">Projects</p>
        <h1 class="head__title reveal">Things I've built</h1>
        <p class="head__intro reveal">
          From AI pipelines and trading automation to production websites for clients — grouped by
          kind.
        </p>
        <ul class="jump reveal" aria-label="Jump to category">
          {
            groups.map((g) => (
              <li>
                <a class="chip jump__chip" href={`#${g.id}`}>
                  {g.title} <span class="jump__count">{g.items.length}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {
      groups.map((g, i) => (
        <section id={g.id} class:list={['section', i % 2 === 0 ? 'bg-aurora' : 'bg-grid']}>
          <div class="container section-split">
            <h2 class="section-title reveal">{g.title}</h2>
            <div class="group">
              <p class="group__blurb reveal">{g.blurb}</p>
              {g.items.map((p) => <ProjectCard project={p} />)}
            </div>
          </div>
        </section>
      ))
    }
  </main>
  <Footer />
</Base>

<style>
  .head {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
    border-bottom: 1px solid var(--border);
  }
  .head__title {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0.6rem 0 0.9rem;
  }
  .head__intro {
    max-width: 620px;
    font-size: 1.05rem;
    color: var(--text-muted);
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }
  .jump__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text);
  }
  .jump__chip:hover {
    border-color: var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
  .jump__count {
    font-family: var(--font-mono);
    font-size: 0.75em;
    color: var(--text-muted);
  }
  section[id] {
    scroll-margin-top: 4rem;
  }
  .group {
    display: grid;
    gap: 1.25rem;
  }
  .group__blurb {
    color: var(--text-muted);
  }
</style>
