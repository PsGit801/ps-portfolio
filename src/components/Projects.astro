---
import { projects } from '../data/resume';
import ProjectCard from './ProjectCard.astro';

// Home-page teaser: a few highlights, with the full list on /projects.
const highlights = projects.filter((p) => p.highlight);
---

<section id="projects" class="section bg-aurora">
  <div class="container section-split">
    <h2 class="section-title reveal">Projects</h2>

    <div class="projects">
      {highlights.map((p) => <ProjectCard project={p} />)}

      <a class="all-projects reveal" href="/projects">
        View all projects ({projects.length}) <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .projects {
    display: grid;
    gap: 1.25rem;
  }
  .all-projects {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1.2rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--accent);
    transition: background 0.15s ease, color 0.15s ease;
  }
  .all-projects:hover {
    background: var(--accent);
    color: #fff;
    text-decoration: none;
  }
  .all-projects span {
    transition: transform 0.15s var(--ease);
  }
  .all-projects:hover span {
    transform: translateX(3px);
  }
</style>
